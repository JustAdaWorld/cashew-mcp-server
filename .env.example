# Copy to .env next to compose.yml, fill in, then: chmod 600 .env
# Never commit .env. The client secret lives only in that file on the server.

# Public URL of this server (no trailing slash). The GitHub OAuth App's
# callback must be ${MCP_BASE_URL}/auth/callback
MCP_BASE_URL=https://cashew.lilrkt.net

# GitHub OAuth App owned by Ada
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins or numeric user IDs allowed to sign in
MCP_ALLOWED_GITHUB_USERS=

# Optional. Defaults to /data/cashew.sqlite in the image
# CASHEW_DB_PATH=/data/cashew.sqlite
